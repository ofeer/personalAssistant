{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.12"
  },
  "steps": {
    "install": {
      "commands": ["pip install -r backend/requirements.txt"]
    }
  },
  "deploy": {
    "startCommand": "cd backend && exec python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"
  }
}
